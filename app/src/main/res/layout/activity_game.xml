<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.studiolexair.preguntascalientes.utils.views.ParticleView
        android:id="@+id/particleBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Cabecera jugador + HUD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textAvatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/circle_bg"
                    android:gravity="center"
                    android:text="😎"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textPlayerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jugador"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textPlayerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnEndGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_outline"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="🏁 Fin"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Fila HUD: puntos, racha, pasos, comodines, turno, modo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_outline"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="⭐ 0"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_outline"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:visibility="gone"
                    android:text="🔥 x3"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPasses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_outline"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="🛡️ 3"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textWildcards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_outline"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="🃏 3"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textRound"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Turno 1"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🔥 Preguntas Calientes"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <!-- Timer -->
            <LinearLayout
                android:id="@+id/timerZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="0:20"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/timerProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/surface_light" />
            </LinearLayout>

            <!-- Banner de eventos -->
            <TextView
                android:id="@+id/textBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:visibility="gone"
                android:text="⚠️ EVENTO"
                android:textAlignment="center"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ═════════ CARTA (flip §11, bordes cómic V2.1) ═════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFrame"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="26dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                android:foreground="?attr/selectableItemBackground">

                <!-- Frente (oculta) -->
                <LinearLayout
                    android:id="@+id/cardFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/bg_card_front">

                    <ImageView
                        android:id="@+id/imgFrontIcon"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/ic_flame"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Tipo de carta" />

                    <TextView
                        android:id="@+id/frontEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="🔥"
                        android:textSize="40sp" />

                    <TextView
                        android:id="@+id/frontTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="TURNO DE"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/frontHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="TOCAR PARA DESCUBRIR"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <!-- Reverso (contenido) -->
                <ScrollView
                    android:id="@+id/cardBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:background="@drawable/bg_card_back"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="26dp">

                        <TextView
                            android:id="@+id/textCardType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 CALIENTE"
                            android:textAlignment="center"
                            android:textColor="@color/primary_light"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textCardContent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="¿Pregunta...?"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/textCardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp" />
                    </LinearLayout>
                </ScrollView>
            </androidx.cardview.widget.CardView>

            <!-- Fila verdad o reto -->
            <LinearLayout
                android:id="@+id/rowTruthDare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerdad"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="58dp"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.PreguntasCalientes.Button"
                    android:text="🎤 VERDAD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReto"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.PreguntasCalientes.Button"
                    android:text="💪 RETO" />
            </LinearLayout>

            <!-- Fila votación duelo -->
            <LinearLayout
                android:id="@+id/rowDuelVote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoteA"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.PreguntasCalientes.Button"
                    android:text="👈 A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoteB"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.PreguntasCalientes.Button"
                    android:text="B 👉" />
            </LinearLayout>

            <!-- Fila acciones principales (oculta hasta hacer FLIP) -->
            <LinearLayout
                android:id="@+id/rowActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPositive"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:layout_height="58dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    style="@style/Widget.PreguntasCalientes.Button"
                    android:text="✅ RESPONDÍ" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNegative"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="58dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="13sp"
                    style="@style/Widget.PreguntasCalientes.Button.Secondary"
                    android:text="🙈 NO QUIERO" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPass"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Widget.PreguntasCalientes.Button.Secondary"
                    android:text="🛡️ PASAR" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWildcard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Widget.PreguntasCalientes.Button.Secondary"
                    android:text="🃏 COMODÍN" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- XP flotante -->
    <TextView
        android:id="@+id/textFloatXp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="140dp"
        android:text="+30 XP"
        android:textColor="@color/accent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Confeti -->
    <com.studiolexair.preguntascalientes.utils.views.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false" />

    <!-- Cuenta regresiva overlay -->
    <FrameLayout
        android:id="@+id/overlayCountdown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dark"
        android:visibility="gone">

        <TextView
            android:id="@+id/textCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="90sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
