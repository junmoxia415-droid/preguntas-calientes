<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.studiolexair.preguntascalientes.utils.views.ParticleView
        android:id="@+id/particleBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="❮"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="👥 Jugadores"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 jugador(es)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="🔥 Modo"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Formulario nuevo jugador -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre del jugador"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/primary"
                        android:maxLength="14"
                        android:maxLines="1" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPronoun"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Pronombre (opcional: ella/él/elle)"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/primary"
                        android:maxLength="8"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Elige tu avatar:"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <LinearLayout
                            android:id="@+id/layoutAvatars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPartner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="❤️  Tiene pareja"
                        android:textColor="@color/text_primary" />

                    <!-- Vínculo de pareja: elegir jugador existente o escribir su nombre -->
                    <LinearLayout
                        android:id="@+id/containerPartner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Spinner
                            android:id="@+id/spinnerPartner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input"
                            android:padding="12dp" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPartnerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Nombre de su pareja (se vinculará cuando la agregues)"
                            android:textColorHint="@color/text_hint"
                            android:textColor="@color/text_primary"
                            android:backgroundTint="@color/primary"
                            android:maxLength="14"
                            android:maxLines="1" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.PreguntasCalientes.Button.Secondary"
                        android:text="➕ Agregar jugador" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="No hay jugadores aún. ¡Agrega al menos 2! 👀"
                android:textColor="@color/text_hint"
                android:textSize="14sp" />

            <!-- Lista -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPlayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@null"
                android:background="@drawable/bg_button_glow"
                app:backgroundTint="@null"
                android:text="🎮 COMENZAR"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
